{
  "name": "ai-almanac",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run check:release",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "check:release": "node --experimental-strip-types scripts/check-release.ts",
    "lint:ui": "playwright test --config playwright.config.ts",
    "test:animations": "playwright test --config playwright.playback.config.ts"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
